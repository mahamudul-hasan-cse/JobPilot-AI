# JobPilot AI — environment variable template
# Copy to .env and fill in values (optional; config/secrets.py is the primary config)
# Author: Md. Mahamudul Hasan
#
# Usage:
#   copy .env.example .env
#   Edit .env with your values
#
# Note: The bot reads config/secrets.py by default. Use .env only if you
# extend the project to load credentials from the environment.

# LinkedIn credentials
LINKEDIN_USERNAME=your.email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# AI provider (gemini | openai | deepseek)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Flask dashboard (optional)
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
